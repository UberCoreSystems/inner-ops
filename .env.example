# Firebase Configuration
# Get these values from your Firebase project settings
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_APP_ID=your_app_id

# PostHog Product Analytics (optional)
# Get the project API key from PostHog → Project Settings → Project API Key.
# Leave blank to disable analytics entirely (posthog-js is never loaded).
VITE_POSTHOG_KEY=
# Optional: override the ingestion host (defaults to https://us.i.posthog.com).
VITE_POSTHOG_HOST=

# Sentry Error Tracking (optional but strongly recommended for production)
# Get your DSN from https://sentry.io → Project Settings → Client Keys (DSN)
# Leave blank to disable Sentry (app still works without it)
VITE_SENTRY_DSN=

# AI (Claude) — handled server-side via Firebase Cloud Functions.
# NEVER put your Anthropic API key here. Set it as a Firebase secret instead:
#   firebase functions:secrets:set ANTHROPIC_API_KEY
# The Claude API key stays on the server and is never exposed to the browser.

# Firebase App Check (reCAPTCHA v3). Public site key — safe to ship.
# Get it from Firebase Console → App Check → register the web app (reCAPTCHA v3).
# Leave blank to skip App Check init entirely (app still boots normally).
# Enforcement is turned on server-side per-function AFTER monitoring confirms
# real traffic is verified — do NOT enforce before that or you lock users out.
VITE_APPCHECK_SITE_KEY=
# Optional: fixed debug token for local dev (else a token is printed to the
# browser console on first load). Register it under App Check → Manage debug
# tokens. Dev-only; never set in production.
VITE_APPCHECK_DEBUG_TOKEN=

# Deferred-feature gates. Default OFF for v1; flip to true to re-enable.
VITE_ENABLE_OURA=false
# The two vars below are read only when VITE_ENABLE_OURA=true. Leave blank
# while the gate is off — the Oura OAuth flow is unreachable without it.
# Client ID from Oura Cloud → your application.
VITE_OURA_CLIENT_ID=
# Optional: OAuth redirect override (defaults to <origin>/oura/callback).
VITE_OURA_REDIRECT_URI=
